# ==============================================================================
# SecVal Environment Configuration
# ==============================================================================

# Mode Configuration (local | aws)
ENVIRONMENT=local

# Local Execution Ports
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AWS Credentials & Bedrock AgentCore Settings (Only required for AWS deployment mode)
AWS_REGION=us-east-1
AWS_PROFILE=zt-demo-deployer
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Cedar Engine Binary Path (defaults to system PATH or ~/.cargo/bin/cedar)
CEDAR_BIN_PATH=/Users/arjun/.cargo/bin/cedar
